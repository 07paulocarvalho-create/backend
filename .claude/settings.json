{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Edit(./.env)",
      "Write(./.env)",
      "Bash(cat .env)",
      "Bash(printenv)",
      "Bash(env)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protegerEnv.ts\""
          }
        ]
      }
    ]
  }
}
